# Local / personal (never push)
.notes/
config.local.toml
.cursor/

# Runtime artifacts
runs/
logs/
*.log
*.nohup.out
outputs/
checkpoints/
/experiments/
*.safetensors
*.pth
*.bin
*.pt

# Downloaded training data (regenerate: python -m es_capacity.cli.fetch_train_data)
# README.md + SHA256 stay committed so the download stays verifiable.
data/simplerl_*/train.jsonl

# Model / HF caches
.hf_cache/
.cache/
huggingface/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/
.env
.env.*

# Editors / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Coverage / test
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Wandb
wandb/

# Raw per-shard generation outputs (large; regenerate via run_base_vs_trained_eval.sh /
# run_third_model_eval.sh). Only the derived summaries/plots belong in git.
results/*/base/
results/*/trained/
results/*/rl/
results/*/*.log
results/*_run.log
outputs/

# Raw per-sample lm-eval-harness dumps (~2.6MB each, and they embed the verbatim
# benchmark text — which is how a presigned S3 URL in the GPQA corpus once tripped
# GitHub secret scanning). The results_*.json score summaries alongside them stay.
results/gpqa_diamond/*/*/samples_*.jsonl

# Transient per-shard model copies from run_sharded_eval.sh (cleaned up on
# exit via its EXIT trap; ignored defensively in case a run dies uncleanly)
**/model_shards.*/
